<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="M-PESA Payment"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student ID Number"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etMpesaStudentID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Student ID"
            android:enabled="false"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="M-PESA Phone Number"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etMpesaPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 07XXXXXXXX"
            android:inputType="phone"
            android:maxLength="13"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Payment Amount (KSh)"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etMpesaAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter amount"
            android:inputType="numberDecimal"
            android:text="1"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnInitiatePayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initiate M-PESA Payment"/>

        <TextView
            android:id="@+id/tvPaymentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Payment Status: Not Initiated"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvTransactionCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transaction Code: Not Available"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnConfirmPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm Payment"
            android:enabled="false"/>

    </LinearLayout>

</ScrollView>
